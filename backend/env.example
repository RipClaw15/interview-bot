# Required Groq configuration
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Resend email delivery
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="AI Interviewer <results@mail.yourdomain.com>"

# Optional report storage location
# INTERVIEW_DATA_DIR=/absolute/path/to/interview/data

# Upload and in-memory document-session limits
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_SESSIONS=100
SESSION_TTL_SECONDS=3600

# JSON array of allowed browser origins
ALLOWED_ORIGINS=["http://localhost:3000"]
